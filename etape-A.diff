+// Négation explicite juste avant une mention (« not a Korean film », « isn't Korean », « n'est pas un film
+// coréen »…) : un mot de négation suivi d'au plus 3 mots, dans la même proposition. Générique : s'applique au
+// géoRx de N'IMPORTE quel pays/adjectif (FUZZY_GEO_TABLE), aucun terme en dur. « not only / pas seulement »
+// n'est pas une négation. Texte déjà normalisé par norm() (minuscule, sans accents).
+const FUZZY_NEGATED_LEAD_RX = /\b(?:not|isn['’]t|wasn['’]t|aren['’]t|weren['’]t|n['’]est\s+pas|n['’]etait\s+pas|ne\s+sont\s+pas|pas)\b(?!\s+(?:only|just|merely|simply|seulement|uniquement)\b)(?:\s+[^\s.!?;,:()]+){0,3}\s*$/;
+
+function geoMentionIsNegated(txt, idx) {
+  const lead = txt.slice(Math.max(0, idx - 48), idx);
+  const cut = Math.max(...['.', '!', '?', ';', ',', ':'].map((c) => lead.lastIndexOf(c)));
+  return FUZZY_NEGATED_LEAD_RX.test(lead.slice(cut + 1));
+}
