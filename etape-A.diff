+  const txt = fuzzyResultText(r);
+  const rx = new RegExp(fuzzyCtx.geoRx.source, 'gi');
+  let negated = 0;
+  let affirmed = 0;
+  let m;
+  while ((m = rx.exec(txt))) {
+    if (!m[0].length) { rx.lastIndex++; continue; }
+    if (geoMentionIsNegated(txt, m.index)) negated++; else affirmed++;
+  }
+  return negated > 0 && affirmed === 0;
